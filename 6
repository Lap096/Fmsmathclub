<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Google Classroom</title>
    <link rel="icon" href="https://upload.wikimedia.org/wikipedia/commons/5/59/Google_Classroom_Logo.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            margin: 0;
            height: 100vh;
            background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .card {
            background: rgba(0,0,0,0.9);
            padding: 40px;
            border-radius: 12px;
            width: 400px;
            text-align: center;
        }
        input, button {
            width: 100%;
            padding: 14px;
            margin: 10px 0;
            border: none;
            border-radius: 6px;
            font-size: 16px;
        }
        input { background: #1c1c1c; color: white; }
        .signin { background: #4CAF50; }
        .signin:hover { background: #45a049; }
        .ownerBtn { background: #f59e0b; }
        .ownerBtn:hover { background: #d97706; }
    </style>
</head>
<body>

<div class="card">
    <h2>Google Classroom</h2>
    <input id="username" placeholder="Username or email">
    <input id="password" type="password" placeholder="Password">
    <button class="signin" onclick="checkLogin()">Sign in</button>
    <div id="error" style="color:#ff4d4d;margin-top:10px;display:none;">Invalid username or password</div>
</div>

<script>
const SALT = "8fj29f92jf";
async function sha256(text) {
    const data = new TextEncoder().encode(text + SALT);
    const hash = await crypto.subtle.digest("SHA-256", data);
    return Array.from(new Uint8Array(hash)).map(b => b.toString(16).padStart(2,'0')).join('');
}

let users = JSON.parse(localStorage.getItem("users")) || null;
async function initUsers() {
    if (users) return;
    users = {};
    users["lap0963"] = await sha256("my8vc2f3");
    users["chickenegg"] = await sha256("chicken@s");
    localStorage.setItem("users", JSON.stringify(users));
}
initUsers();

async function checkLogin() {
    const username = document.getElementById("username").value.trim();
    const password = document.getElementById("password").value;
    const hash = await sha256(password);

    if (username === "lap0963" && password === "my8vc2f3") {
        showOwnerPanel();
        return;
    }

    if (users[username] && users[username] === hash) {
        openLauncherTab();
        setTimeout(() => window.location.href = "https://classroom.google.com/", 800);
    } else {
        document.getElementById("error").style.display = "block";
        setTimeout(() => document.getElementById("error").style.display = "none", 2500);
    }
}

// ==================== OWNER PANEL ====================
function showOwnerPanel() {
    document.body.innerHTML = `
    <div class="card">
        <h2>Owner Panel</h2>
        <input id="newUser" placeholder="New Username">
        <input id="newPass" type="password" placeholder="New Password">
        <button class="ownerBtn" onclick="addUser()">Add User</button>
        <input id="delUser" placeholder="Username to Delete">
        <button class="ownerBtn" onclick="deleteUser()">Delete User</button>
        <button class="ownerBtn" onclick="viewUsers()">View All Users</button>
        <div id="userList" style="text-align:left;margin-top:15px;font-size:14px;max-height:300px;overflow:auto;"></div>
        <button onclick="openLauncherTab()" style="margin-top:20px;background:#666;">Go to Launcher</button>
    </div>`;
}

async function addUser() {
    const u = document.getElementById("newUser").value.trim();
    const p = document.getElementById("newPass").value;
    if (!u || !p) return alert("Fill both fields");
    if (users[u]) return alert("User already exists");
    users[u] = await sha256(p);
    localStorage.setItem("users", JSON.stringify(users));
    alert("User added successfully");
}

function deleteUser() {
    const u = document.getElementById("delUser").value.trim();
    if (u === "lap0963") return alert("Cannot delete owner account");
    if (users[u]) {
        delete users[u];
        localStorage.setItem("users", JSON.stringify(users));
        alert("User deleted");
    } else alert("User not found");
}

function viewUsers() {
    const list = Object.keys(users).map(u => "• " + u).join("<br>");
    document.getElementById("userList").innerHTML = list;
}

// ==================== LAUNCHER TAB ====================
function openLauncherTab() {
    const win = window.open("about:blank", "_blank");
    if (!win) return alert("Pop-up blocked! Allow pop-ups.");

    setTimeout(() => {
        win.document.title = "Google Classroom";
        win.document.write(`
<!DOCTYPE html>
<html>
<head>
    <title>Google Classroom</title>
    <link rel="icon" href="https://upload.wikimedia.org/wikipedia/commons/5/59/Google_Classroom_Logo.png">
    <style>
        body { background:#0f172a; color:white; font-family:Arial; text-align:center; padding:30px; margin:0; }
        h2 { margin:20px 0 30px; }
        .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(170px,1fr)); gap:12px; max-width:950px; margin:0 auto; }
        button { padding:18px; font-size:16px; background:#4285f4; border:none; border-radius:8px; color:white; cursor:pointer; width:100%; }
        button:hover { background:#3367d6; }
    </style>
</head>
<body>
    <h2>Google Classroom - Resources</h2>
    <div class="grid">
        <button onclick="window.location.href='https://cdn.jsdelivr.net/gh/shayderrr/eaglercraft@main/resent/clresentclient.html.part1'">English Resources</button>
        <button onclick="window.location.href='https://cdn.jsdelivr.net/gh/shayderrr/eaglercraft@main/wurst/clwurstclient.html.part1'">Math Tools</button>
        <button onclick="window.location.href='https://cdn.jsdelivr.net/gh/shayderrr/eaglercraft@main/tuff/clTuff_Client_Offline_WASM.html.part1'">Science Lab</button>
        <button onclick="window.location.href='https://cdn.jsdelivr.net/gh/shayderrr/eaglercraft@main/clnovaclient.html'">History Notes</button>
        <button onclick="window.location.href='https://cdn.jsdelivr.net/gh/shayderrr/eaglercraft@main/pixel/clpixelclient.html.part1'">Art Studio</button>
        <button onclick="alert('More clients will be added soon...')">More Resources</button>
    </div>
</body>
</html>`);
        win.document.close();
    }, 400);
}
</script>
</body>
</html>
